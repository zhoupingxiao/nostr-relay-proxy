{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nostr-relay-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "keep_vars": true,
  "observability": { "enabled": true },
  "ratelimits": [
    {
      "name": "CONNECTION_LIMIT",
      "namespace_id": "9432107",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "RelayHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayHub"]
    }
  ]
}
